{
	"disabled": false,
	"pathTemplate": "~/.humanlayer/workspaces/{{ TASKSLUG }}/{{ REPOBASENAME }}",
	"branchTemplate": "{{ TASKSLUG }}",
	"sourceRef": "HEAD",
	"setupCommand": "pnpm install",
	"copyGlobs": [
		".env",
		".env.local",
		".env.development.local",
