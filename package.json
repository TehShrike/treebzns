{
	"name": "treebzns",
	"version": "1.0.0",
	"description": "",
	"homepage": "https://github.com/TehShrike/treebzns#readme",
	"bugs": {
		"url": "https://github.com/TehShrike/treebzns/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/TehShrike/treebzns.git"
	},
	"imports": {
		"#shared/*": "./shared/*",
		"#schema/*": "./schema/*",
		"#arbostar_export/*": "./arbostar_export/*",
		"#client/lib/*": "./client/lib/*",
		"#client/component/*": "./client/component/*",
		"#worker/lib/*": "./worker/lib/*"
	},
	"license": "UNLICENSED",
	"author": "TehShrike",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"regenerate_worker_types": "wrangler types ./worker/worker_types.d.ts",
		"test": "run-p test:*",
		"test:types": "run-p -c test:types:*",
		"test:types:everything_else": "tsc --noEmit",
		"test:types:worker": "tsc -p worker --noEmit",
		"test:types:svelte": "svelte-check --tsconfig ./client/tsconfig.json --fail-on-warnings",
		"test:unit": "node --test \"shared/**/*.test.ts\" \"scripts/**/*.test.ts\"",
		"db_up": "run-s db_migrate db_export_schema",
		"local:db_export_schema": "dotenv -- node scripts/export_schema.ts",
		"local:db_migrate": "dotenv -- node scripts/migrate.ts",
		"prod:db_export_schema": "node scripts/export_schema.ts",
		"prod:db_migrate": "node scripts/migrate.ts",
		"dev": "npm-run-all build --parallel dev:*",
		"dev:wrangler": "wrangler dev",
		"dev:glob": "run-p dev:glob:*",
		"dev:glob:states": "watchlist client/route --no-clear -- npm run build:glob:states",
		"dev:glob:server_functions": "watchlist worker/server_functions --no-clear -- run-p build:server_function_types build:glob:server_functions",
		"dev:client_build": "node esbuild.client.ts --watch",
		"deploy": "wrangler deploy",
		"build:server_function_types": "node scripts/generate_server_function_types.ts",
		"build": "npm-run-all build:server_function_types build:glob build:*",
		"build:glob": "run-p build:glob:*",
		"build:glob:states": "glob-module-file --pattern=\"client/route/**/*.State.svelte\" --format=es --importStar --exportWithPath --pathPrefix=../ --outputPath=client/globbed_states.generated.ts",
		"build:glob:server_functions": "glob-module-file --pattern=\"worker/server_functions/**/*.fns.ts\" --format=es --importStar --exportWithPath --pathPrefix=../ --outputPath=worker/server_functions.generated.ts",
		"build:client": "node esbuild.client.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260511.1",
		"@types/node": "^25.6.0",
		"dotenv-cli": "^11.0.0",
		"esbuild": "^0.28.0",
		"esbuild-svelte": "^0.9.5",
		"glob-module-file": "^3.2.0",
		"npm-run-all2": "^9.0.2",
		"puppeteer-core": "^25.2.1",
		"svelte": "^5.55.5",
		"typescript": "^6.0.3",
		"watchlist": "^0.3.1",
		"wrangler": "^4.88.0"
	},
	"packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1",
		"@tehshrike/json_anything": "^1.1.0",
		"abstract-state-router": "^8.0.6",
		"financial-number": "^5.0.0",
		"mysql2": "^3.22.3",
		"sql-escaper": "^1.3.3",
		"sql-tagged-template-literal": "^1.3.0",
		"svelte-check": "^4.5.0",
		"svelte-state-renderer": "^6.0.0"
	},
	"engines": {
		"node": ">=25"
	}
}
