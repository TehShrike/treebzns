{
	"name": "treebzns",
	"version": "1.0.0",
	"description": "",
	"homepage": "https://github.com/TehShrike/treebzns#readme",
	"bugs": {
		"url": "https://github.com/TehShrike/treebzns/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/TehShrike/treebzns.git"
	},
	"imports": {
		"#shared/*": "./src/shared/*",
		"#schema/*": "./schema/*",
		"#arbostar_export/*": "./arbostar_export/*",
		"#arbostar_api_export/*": "./arbostar_api_export/*",
		"#lib/*": {
			"client": "./src/client/lib/*",
			"worker": "./src/worker/lib/*"
		},
		"#component/*": {
			"client": "./src/client/component/*"
		}
	},
	"license": "UNLICENSED",
	"author": "TehShrike",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"regenerate_worker_types": "wrangler types ./src/worker/worker_types.d.ts",
		"test": "run-p test:*",
		"test:types": "run-p -c test:types:*",
		"test:types:everything_else": "tsc --noEmit",
		"test:types:worker": "tsc -p src/worker --noEmit",
		"test:types:svelte": "svelte-check --tsconfig ./src/client/tsconfig.json --fail-on-warnings",
		"test:unit": "run-p -c test:unit:*",
		"test:unit:shared": "node --test \"src/shared/**/*.test.ts\" \"scripts/**/*.test.ts\"",
		"test:unit:client": "node --conditions=client --test \"src/client/**/*.test.ts\"",
		"test:unit:worker": "node --conditions=worker --test \"src/worker/**/*.test.ts\"",
		"smoke:spaces": "dotenv -- node src/shared/s3/spaces_smoke_test.ts",
		"arbostar:api_export": "dotenv -- node scripts/arbostar_api/export_all.ts",
		"import:arbostar_web": "dotenv -- node scripts/import_arbostar_export.ts",
		"import:arbostar_api": "dotenv -- node scripts/import_arbostar_api_export.ts",
		"import_from_all_sources": "run-s \"import:arbostar_web {@}\" \"import:arbostar_api {@}\" --",
		"local:db_up": "run-s local:db_migrate local:db_export_schema",
		"local:db_export_schema": "dotenv -- node scripts/export_schema.ts && ./stage_schema_files.sh",
		"local:db_migrate": "dotenv -- node scripts/migrate.ts",
		"prod:db_up": "run-s prod:db_migrate prod:db_export_schema",
		"prod:db_export_schema": "node scripts/export_schema.ts",
		"prod:db_migrate": "node scripts/migrate.ts",
		"dev": "npm-run-all build --parallel dev:*",
		"dev:wrangler": "dotenv -- sh -c 'WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=mysql://$MYSQL_USER:$MYSQL_PASS@$MYSQL_HOST:$MYSQL_PORT/$MYSQL_DB wrangler dev --live-reload'",
		"dev:glob": "run-p dev:glob:*",
		"dev:glob:states": "watchlist src/client/route --no-clear -- npm run build:glob:states",
		"dev:glob:server_functions": "watchlist src/worker/server_functions --no-clear -- run-p build:server_function_types build:glob:server_functions",
		"dev:client_build": "node esbuild.client.ts --watch",
		"deploy": "wrangler deploy",
		"build:server_function_types": "node scripts/generate_server_function_types.ts",
		"build": "npm-run-all build:server_function_types build:glob build:*",
		"build:glob": "run-p build:glob:*",
		"build:glob:states": "glob-module-file --pattern=\"src/client/route/**/*.State.svelte\" --format=es --importStar --exportWithPath --pathPrefix=../../ --outputPath=src/client/globbed_states.generated.ts",
		"build:glob:server_functions": "glob-module-file --pattern=\"src/worker/server_functions/**/*.fns.ts\" --format=es --importStar --exportWithPath --pathPrefix=../../ --outputPath=src/worker/server_functions.generated.ts",
		"build:client": "node esbuild.client.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260511.1",
		"@types/node": "^25.6.0",
		"dotenv-cli": "^11.0.0",
		"esbuild": "^0.28.0",
		"esbuild-svelte": "^0.9.5",
		"glob-module-file": "^3.2.0",
		"npm-run-all2": "^9.0.2",
		"puppeteer-core": "^25.2.1",
		"sharp": "^0.35.5",
		"svelte": "^5.55.5",
		"typescript": "^6.0.3",
		"typescript-svelte-plugin": "^0.3.52",
		"watchlist": "^0.3.1",
		"wrangler": "^4.88.0"
	},
	"packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e",
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1",
		"@tehshrike/json_anything": "^1.1.0",
		"abstract-state-router": "^8.0.6",
		"financial-number": "^5.0.0",
		"mysql2": "^3.22.3",
		"sql-escaper": "^1.3.3",
		"sql-tagged-template-literal": "^1.3.0",
		"svelte-check": "^4.5.0",
		"svelte-state-renderer": "^6.0.0"
	},
	"engines": {
		"node": ">=25"
	}
}
