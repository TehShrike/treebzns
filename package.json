{
	"name": "treebzns",
	"version": "1.0.0",
	"description": "",
	"homepage": "https://github.com/TehShrike/treebzns#readme",
	"bugs": {
		"url": "https://github.com/TehShrike/treebzns/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/TehShrike/treebzns.git"
	},
	"imports": {
		"#shared/*": "./shared/*",
		"#schema/*": "./schema/*",
		"#client/lib/*": "./client/lib/*",
		"#worker/lib/*": "./worker/lib/*"
	},
	"license": "UNLICENSED",
	"author": "TehShrike",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"regenerate_worker_types": "wrangler types ./worker/worker_types.d.ts",
		"test": "run-p test:*",
		"test:types": "run-p -c test:types:*",
		"test:types:everything_else": "tsc --noEmit",
		"test:types:worker": "tsc -p worker --noEmit",
		"test:types:svelte": "svelte-check --tsconfig ./client/tsconfig.json --fail-on-warnings",
		"test:unit": "node --test shared/**/*.test.ts scripts/**/*.test.ts",
		"export_schema": "dotenv -- node scripts/export_schema.ts",
		"db:reset": "dotenv -- bash scripts/reset-db.sh",
		"dev": "npm-run-all build --parallel dev:*",
		"dev:wrangler": "wrangler dev",
		"dev:glob_states": "watchlist routes --no-clear -- npm run glob",
		"dev:client_build": "node esbuild.client.ts --watch",
		"deploy": "wrangler deploy",
		"generate_server_function_types": "node scripts/generate_server_function_types.ts",
		"build": "npm-run-all build:glob_states build:*",
		"build:glob_states": "glob-module-file --pattern=\"client/route/**/*.State.svelte\" --format=es --importStar --exportWithPath --pathPrefix=../ --outputPath=client/globbed_states.generated.ts",
		"build:client": "node esbuild.client.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260511.1",
		"@types/node": "^25.6.0",
		"dotenv-cli": "^11.0.0",
		"esbuild": "^0.28.0",
		"esbuild-svelte": "^0.9.5",
		"glob-module-file": "^3.2.0",
		"npm-run-all": "^4.1.5",
		"svelte": "^5.55.5",
		"typescript": "^6.0.3",
		"watchlist": "^0.3.1",
		"wrangler": "^4.88.0"
	},
	"packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1",
		"@tehshrike/json_anything": "^1.1.0",
		"abstract-state-router": "^8.0.6",
		"financial-number": "^5.0.0",
		"mysql2": "^3.22.3",
		"sql-tagged-template-literal": "^1.3.0",
		"svelte-check": "^4.5.0",
		"svelte-state-renderer": "^6.0.0"
	},
	"engines": {
		"node": ">=25"
	}
}
