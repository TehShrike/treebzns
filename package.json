{
	"name": "treebzns",
	"version": "1.0.0",
	"description": "",
	"homepage": "https://github.com/TehShrike/treebzns#readme",
	"bugs": {
		"url": "https://github.com/TehShrike/treebzns/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/TehShrike/treebzns.git"
	},
	"imports": {
		"#shared/*": "./shared/*",
		"#schema/*": "./schema/*"
	},
	"license": "UNLICENSED",
	"author": "TehShrike",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"test": "run-p test:*",
		"test:types:everything_else": "tsc --noEmit",
		"test:types": "run-p -c test:types:*",
		"test:unit": "node --test shared/**/*.test.ts scripts/**/*.test.ts",
		"export_schema": "dotenv -- node shared/schema_dumper/index.ts",
		"db:reset": "dotenv -- bash scripts/reset-db.sh",
		"dev": "npm-run-all build:worker --parallel dev:*",
		"dev:wrangler": "wrangler dev",
		"dev:worker_build": "node esbuild.worker.ts --watch",
		"deploy": "wrangler deploy",
		"generate_server_function_types": "node scripts/generate_server_function_types.ts",
		"build:worker": "node esbuild.worker.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260511.1",
		"@types/node": "^25.6.0",
		"dotenv-cli": "^11.0.0",
		"esbuild": "^0.28.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^6.0.3",
		"wrangler": "^4.88.0"
	},
	"packageManager": "pnpm@10.32.1",
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1",
		"financial-number": "^5.0.0",
		"mysql2": "^3.22.3"
	},
	"engines": {
		"node": ">=25"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
